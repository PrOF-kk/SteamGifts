<resources>
    <!-- Base application theme. -->
    <style name="AppTheme.Light" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="colorDefaultBackground">@color/colorPrimary</item>
        <item name="colorCardBackground">#ffffff</item>
        <item name="colorBehindCardBackground">@color/colorTransparent</item>
        <item name="colorLightSeparatorBackground">#d8d8d8</item>
        <item name="colorLighterSeparatorBackground">#cccccc</item>
        <item name="colorAccountHeader">@color/colorPrimary</item>
        <item name="colorHighlightBackground">@color/md_blue_100</item>
        <item name="lightTextColor">#424242</item>
        <item name="colorPre">#e8eef6</item>
        <item name="colorOnPre">#5c7397</item>
        <item name="colorTradeScorePositive">@color/md_green_600</item>
        <item name="colorTradeScoreNegative">@color/md_red_600</item>

        <item name="android:textAllCaps">false</item>

        <!-- MaterialDrawer -->
        <item name="materialDrawerStyle">@style/Widget.MaterialDrawerStyle</item>
        <item name="materialDrawerHeaderStyle">@style/AppTheme.MaterialDrawerHeaderStyle</item>
        <item name="materialDrawerInsetForeground">#00000000</item>
        <item name="materialDrawerBackground">?android:attr/windowBackground</item>

        <!-- Material 3 mapping for AppCompat -->
        <item name="colorSurface">?android:attr/windowBackground</item>
        <item name="colorOnSurface">?android:attr/textColorPrimary</item>
        <item name="colorSurfaceVariant">#eeeeee</item>
        <item name="colorOnSurfaceVariant">?android:attr/textColorSecondary</item>
        <item name="colorSecondaryContainer">?attr/colorControlHighlight</item>
        <item name="colorOnSecondaryContainer">?android:attr/textColorPrimary</item>
        <item name="colorOutline">#79747E</item>

        <!-- Fallback for possible AppCompat quirks -->
        <item name="materialDrawerHeaderSelectionText">@color/md_white_1000</item>
        <item name="materialDrawerHeaderSelectionSubtext">@color/md_white_1000</item>
    </style>

    <style name="AppTheme.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/dark.colorPrimary</item>
        <item name="colorPrimaryDark">#000000</item>
        <item name="colorAccent">@color/colorAccent</item>

        <item name="colorDefaultBackground">@color/dark.colorPrimary</item>
        <item name="colorCardBackground">@color/dark.colorPrimary</item>
        <item name="colorBehindCardBackground">@color/colorTransparent</item>
        <item name="colorLightSeparatorBackground">#666666</item>
        <item name="colorLighterSeparatorBackground">#333333</item>
        <item name="colorAccountHeader">#000000</item>
        <item name="colorHighlightBackground">@color/md_blue_grey_700</item>
        <item name="lightTextColor">#777777</item>
        <item name="colorPre">#222220</item>
        <item name="colorOnPre">#b7b776</item>
        <item name="colorTradeScorePositive">@color/md_green_600</item>
        <item name="colorTradeScoreNegative">@color/md_red_600</item>

        <item name="android:textAllCaps">false</item>

        <!-- MaterialDrawer -->
        <item name="materialDrawerStyle">@style/Widget.MaterialDrawerStyle</item>
        <item name="materialDrawerHeaderStyle">@style/AppTheme.MaterialDrawerHeaderStyle</item>
        <item name="materialDrawerInsetForeground">#00000000</item>
        <item name="materialDrawerBackground">?android:attr/windowBackground</item>

        <!-- Material 3 mapping for AppCompat -->
        <item name="colorSurface">@color/dark.colorPrimary</item>
        <item name="colorOnSurface">#ffffff</item>
        <item name="colorSurfaceVariant">#444444</item>
        <item name="colorOnSurfaceVariant">#cccccc</item>
        <item name="colorSecondaryContainer">#333333</item>
        <item name="colorOnSecondaryContainer">#ffffff</item>
        <item name="colorOutline">#938F99</item>

        <!-- Fallback for possible AppCompat quirks -->
        <item name="materialDrawerHeaderSelectionText">@color/md_white_1000</item>
        <item name="materialDrawerHeaderSelectionSubtext">@color/md_white_1000</item>
    </style>

    <style name="AppTheme.MaterialDrawerHeaderStyle" parent="Widget.MaterialDrawerHeaderStyle">
        <item name="materialDrawerHeaderSelectionText">@color/md_white_1000</item>
        <item name="materialDrawerHeaderSelectionSubtext">@color/md_white_1000</item>
    </style>

    <style name="TransparentText" parent="@android:style/TextAppearance">
        <item name="android:textColor">#00000000</item>
    </style>

    <style name="BigText" parent="@android:style/TextAppearance.Small">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="NormalText" parent="@android:style/TextAppearance.Small">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="MediumText" parent="@android:style/TextAppearance.Small">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SmallText" parent="@android:style/TextAppearance.Small">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MediumButton" parent="@style/Widget.AppCompat.Button.Borderless">
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">8dp</item>
    </style>

    <style name="MediumButton.Colored" parent="@style/Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">8dp</item>
    </style>

    <!-- Comment Styles -->

    <style name="SmallText.Light" parent="SmallText">
        <item name="android:textColor">?attr/lightTextColor</item>
    </style>

    <style name="SmallText.NormalUser" parent="SmallText.Light">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SmallText.HighlightOp" parent="SmallText">
        <item name="android:textColor">@color/md_white_1000</item>
        <item name="android:background">?attr/colorAccountHeader</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Use rather rectangular image in the account header. -->
    <style name="BezelImageView">
        <item name="materialDrawerMaskDrawable">@drawable/material_drawer_square_mask</item>
        <item name="materialDrawerDrawCircularShadow">false</item>
        <item name="materialDrawerSelectorOnPress">@color/material_drawer_primary</item>
    </style>

    <style name="GiveawayIndicatorIcon">
        <item name="android:layout_width">@dimen/giveaway_list_indicator_size</item>
        <item name="android:layout_height">@dimen/giveaway_list_indicator_size</item>
        <item name="android:layout_marginRight">@dimen/giveaway_list_indicator_padding</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="GameFeaturesIcon">
        <item name="android:layout_width">@dimen/game_features_indicator_size</item>
        <item name="android:layout_height">@dimen/game_features_indicator_size</item>
        <item name="android:layout_marginLeft">@dimen/game_features_indicator_padding</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>
</resources>
